# Bundled Ollama profile. This is for local models in the ollama/ollama container.
# Do not assume Ollama Cloud login is available here unless you configure an official auth method yourself.

OPENHANDS_PUBLIC_URL=http://YOUR_SERVER_HOST:3002
OPENHANDS_INTERNAL_BIND=127.0.0.1
OPENHANDS_INTERNAL_PORT=3003
OPENHANDS_PROXY_PORT=3002
OPEN_WEBUI_PORT=3004
MANAGER_PORT=3005
SEARXNG_PORT=8083
OLLAMA_PORT=11434
MANAGER_USERNAME=admin
MANAGER_PASSWORD=change-me
PROXY_API_KEY=ollama
UPSTREAM_MODE=external_ollama
DIRECT_CLOUD_BASE_URL=https://ollama.com
API_KEY_AUTO_FALLBACK=true
DEFAULT_QUOTA_RESET_HOURS=0
SWITCH_THRESHOLD_PERCENT=10
OLLAMA_API_KEYS=

OPENHANDS_DATA_DIR=/opt/openhands-agent/data/openhands
OPENHANDS_HTPASSWD_FILE=/opt/openhands-agent/runtime/htpasswd
SANDBOX_VOLUMES=/opt/openhands-agent/runtime/ssh:/home/openhands/.ssh:rw,/opt/openhands-agent/runtime/skills:/home/openhands/.agents/skills:ro
SANDBOX_CONTAINER_URL_PATTERN=http://YOUR_SERVER_HOST:{port}

OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_BASE_URL=http://manager:8080/llm/v1

LLM_MODEL=openai/qwen3.5:8b
LLM_BASE_URL=http://YOUR_SERVER_HOST:3005/llm/v1
OPENHANDS_LLM_BASE_URL=http://YOUR_SERVER_HOST:3005/llm/v1
OPENHANDS_STREAM=false
LLM_API_KEY=ollama
LLM_DISABLE_VISION=true

DEFAULT_MODELS=qwen3.5:8b
OPENAI_API_KEY=ollama
OPENWEBUI_PUBLIC_URL=http://YOUR_SERVER_HOST:3004
OPENHANDS_API_URL=http://openhands:3000
