# Copy one of the profile-specific examples to .env.
#
# Recommended multiple-account Ollama Cloud API-key routing:
#   cp .env.direct-cloud.example .env
#   docker compose --profile external-ollama up -d --build
#
# Local Windows Ollama already authenticated with Ollama Cloud:
#   cp .env.external-ollama.example .env
#   docker compose --profile external-ollama up -d --build
#
# Containerized Ollama for local models:
#   cp .env.bundled-ollama.example .env
#   docker compose --profile bundled-ollama up -d --build
