# External Ollama profile. Use this when Ollama is already installed outside Docker.

OPENHANDS_PUBLIC_URL=http://YOUR_SERVER_HOST:3002
OPENHANDS_INTERNAL_BIND=127.0.0.1
OPENHANDS_INTERNAL_PORT=3003
OPENHANDS_PROXY_PORT=3002
OPEN_WEBUI_PORT=3004
MANAGER_PORT=3005
SEARXNG_PORT=8083
MANAGER_USERNAME=admin
MANAGER_PASSWORD=change-me
PROXY_API_KEY=ollama
UPSTREAM_MODE=external_ollama
DIRECT_CLOUD_BASE_URL=https://ollama.com
API_KEY_AUTO_FALLBACK=true
DEFAULT_QUOTA_LIMIT_TOKENS=60000
DEFAULT_QUOTA_RESET_HOURS=3.1666666667
ACCOUNT_RECHECK_SECONDS=300
QUOTA_SYNC_ENABLED=true
QUOTA_SYNC_MODEL_LIMIT=12
MODEL_PROBE_ON_START=true
MODEL_PROBE_TIMEOUT=90
LIVE_METRICS_REFRESH_SECONDS=2
LIVE_METRICS_RECENT_LIMIT=50
MANAGER_DATA_DIR=/opt/openhands-agent/data/manager
OPEN_WEBUI_DATA_DIR=/opt/openhands-agent/data/open-webui
SWITCH_THRESHOLD_PERCENT=10
# Optional direct Ollama Cloud API keys.
# You can also add keys later in the manager UI.
# The manager can track estimated quota when you set token limit/reset per key in the UI.
# JSON object example:
# OLLAMA_API_KEYS={"main":"ollama_api_key_here","backup":"ollama_api_key_here"}
OLLAMA_API_KEYS=

# Required host paths from the Docker host perspective.
OPENHANDS_DATA_DIR=/opt/openhands-agent/data/openhands
OPENHANDS_HTPASSWD_FILE=/opt/openhands-agent/runtime/htpasswd
SANDBOX_VOLUMES=/opt/openhands-agent/runtime/ssh:/home/openhands/.ssh:rw,/opt/openhands-agent/runtime/skills:/home/openhands/.agents/skills:ro
SANDBOX_CONTAINER_URL_PATTERN=http://YOUR_SERVER_HOST:{port}

# Existing Ollama endpoint. For Windows, expose Ollama only to the Linux host or use a tunnel/VPN.
OLLAMA_BASE_URL=http://WINDOWS_OLLAMA_HOST:11434
OPENAI_API_BASE_URL=http://manager:8080/llm/v1

# OpenHands uses the manager gateway, which forwards to the external Ollama.
# Use a host/IP reachable from OpenHands sandbox containers.
LLM_MODEL=openai/nemotron-3-super:cloud
LLM_BASE_URL=http://YOUR_SERVER_HOST:3005/llm/v1
OPENHANDS_LLM_BASE_URL=http://YOUR_SERVER_HOST:3005/llm/v1
OPENHANDS_STREAM=false
LLM_API_KEY=ollama
LLM_DISABLE_VISION=true

# Open WebUI default model.
DEFAULT_MODELS=nemotron-3-super:cloud
OPENAI_API_KEY=ollama
OPENWEBUI_PUBLIC_URL=http://YOUR_SERVER_HOST:3004
OPENHANDS_API_URL=http://openhands:3000
